                    <i class="fa fa-info-circle" style="color: #64748b; font-size: 1.2em;"></i>
                    <span style="color: #475569; font-weight: 500;">{{{ gdrivenotrack }}}</span>
                </div>
            {{/showprogressbar}}

            {{#showprogressbar}}
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <h4 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #0f172a; letter-spacing: -0.01em;">{{ progresstitle }}</h4>
                    <p style="margin: 0; font-size: 0.875rem; color: #64748b; line-height: 1.4;">{{{ progresshint }}}</p>
                </div>
                <div style="background: #f8fafc; padding: 6px 14px; border-radius: 24px; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; justify-content: center; min-width: 65px;">
                    <span id="vt-progress-text" class="vt-progress-text" style="font-size: 1rem; font-weight: 700; line-height: 1;">{{currentpercent}}%</span>
                </div>
            </div>
            <div style="height: 10px; border-radius: 100px; background-color: #f1f5f9; overflow: hidden; position: relative; box-shadow: inset 0 1px 2px rgba(0,0,0,0.04);">
                <div id="vt-progress-bar" class="vt-progress-bar-fill" role="progressbar" style="height: 100%; width: {{currentpercent}}%; border-radius: 100px; transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);" aria-valuenow="{{currentpercent}}" aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>
            {{/showprogressbar}}
        </div>
    </div>
</div>

{{#js}}
require(['jquery'], function($) {
    var inPopup = {{#inpopup}}true{{/inpopup}}{{^inpopup}}false{{/inpopup}};

    var applyPopupParentSizing = function() {
        document.documentElement.style.overflowY = 'auto';
        document.body.style.overflowY = 'auto';
        document.body.style.padding = '8px 10px 12px 10px';
        var popCard = document.querySelector('.videotrack-card');
        if (popCard && window.frameElement && window.parent.innerWidth <= 768) {
            var popRect = popCard.getBoundingClientRect();
            var popScroll = window.pageYOffset || document.documentElement.scrollTop || 0;
            var popH = Math.ceil(popRect.bottom + popScroll) + 16;
            if (popH > 220) {
                window.frameElement.style.height = popH + 'px';
            }
        }
    };

    // Auto-resize parent course iframe accurately when rendered in inline embed or mobile popup mode.
    var syncParentIframeHeight = function() {
        var isFs = document.fullscreenElement || document.webkitFullscreenElement ||
                   document.querySelector('.vt-player-wrapper.vt-is-fullscreen');
        if (isFs) {
            return;
        }
        var navEls = document.querySelectorAll(
            '.activity-navigation, .section-navigation, [data-region="activity-navigation"], #prev-activity-link, #next-activity-link'
        );
        for (var i = 0; i < navEls.length; i++) {
            var navWrap = navEls[i].closest('.activity-navigation, .section-navigation, .mt-5, .border-top, nav') || navEls[i];
            navWrap.style.setProperty('display', 'none', 'important');
        }
        if (window.parent && window.parent !== window) {
            try {
                document.body.style.margin = '0';
                document.body.style.background = 'transparent';
                var card = document.querySelector('.videotrack-card');
                if (card) {
                    var parentContainer = card.parentElement;
                    while (parentContainer && parentContainer !== document.body) {
                        var siblings = parentContainer.children;
                        for (var s = 0; s < siblings.length; s++) {
                            if (siblings[s] !== card && !siblings[s].contains(card)) {
                                siblings[s].style.setProperty('display', 'none', 'important');
                            }
                        }
                        parentContainer = parentContainer.parentElement;
                    }
                }
                if (inPopup) {
                    document.documentElement.style.overflowY = 'auto';
                    document.body.style.overflowY = 'auto';
                    document.body.style.padding = '8px 10px 12px 10px';
                    if (card && window.frameElement && window.parent.innerWidth <= 768) {
                        var popH = Math.ceil(card.offsetHeight) + 24;
                        if (popH > 220) {
                            window.frameElement.style.height = popH + 'px';
                        }
                    }
                    return;
                }
                document.documentElement.style.overflow = 'hidden';
                document.body.style.overflow = 'hidden';
                document.body.style.padding = '4px 0 8px 0';
                if (card) {
                    var exactHeight = Math.ceil(card.offsetHeight) + 16;
                    if (exactHeight > 250) {
                        if (window.frameElement) {
                            window.frameElement.style.height = exactHeight + 'px';
                            window.frameElement.style.minHeight = exactHeight + 'px';
                            window.frameElement.style.maxHeight = 'none';
                        }
                        window.parent.postMessage({
                            type: 'vt-resize',
                            cmid: "{{cmid}}",
                            height: exactHeight
                        }, '*');
                    }
                }
            } catch (e) {}
        }
    };

    syncParentIframeHeight();
    $(window).on('load resize', syncParentIframeHeight);
    if (window.ResizeObserver) {
        var cardEl = document.querySelector('.videotrack-card');
        if (cardEl) {
            var ro = new ResizeObserver(function() {
                syncParentIframeHeight();
            });
            ro.observe(cardEl);
        }
    }
    setInterval(syncParentIframeHeight, 400);

    window.videotrackResume = function() {
        var targetPercent = Number("{{currentpercent}}") || 0;
        var savedSeconds = Number("{{highesttime}}") || 0;
        var isYouTube = {{#isyoutube}}true{{/isyoutube}}{{^isyoutube}}false{{/isyoutube}};

        $('#vt-resume-overlay').fadeOut();

        if (!isYouTube) {
            var video = document.getElementById('videotrack-player');
            if (!video) {
                return;
            }
            var doResume = function() {
                var byPercent = video.duration > 0 ? (targetPercent / 100) * video.duration : 0;
                var targetTime = Math.max(savedSeconds, byPercent);
                if (window.videotrackAllowResumeTo) {
                    window.videotrackAllowResumeTo(targetTime, targetPercent);
                }
                video.currentTime = targetTime;
                video.play();
            };
            if (video.readyState >= 1) {
                doResume();
            } else {
                video.addEventListener('loadedmetadata', doResume, {once: true});
                video.load();
            }
        } else {
            if (window.videotrackAllowResumeTo) {
                window.videotrackAllowResumeTo(savedSeconds, targetPercent);
            }
            var attempts = 0;
            var tryYtResume = function() {
                attempts++;
                if (window.ytPlayer && typeof window.ytPlayer.playVideo === 'function') {
                    var dur = (typeof window.ytPlayer.getDuration === 'function') ? window.ytPlayer.getDuration() : 0;
                    var byPercent = dur > 0 ? (targetPercent / 100) * dur : 0;
                    var targetTime = Math.max(savedSeconds, byPercent);
                    if (window.videotrackAllowResumeTo) {
                        window.videotrackAllowResumeTo(targetTime, targetPercent);
                    }
                    if (targetTime > 0 && dur > 0) {
                        window.ytPlayer.seekTo(targetTime, true);
                    }
                    window.ytPlayer.playVideo();
                    return true;
                }
                return false;
            };

            if (!tryYtResume()) {
                var waitYt = setInterval(function() {
                    if (tryYtResume() || attempts > 30) {
                        clearInterval(waitYt);
                    }
                }, 150);
            }
        }
    };

    $('#vt-resume-btn').on('click', function(e) {
        e.preventDefault();
        window.videotrackResume();
    });

    var isYouTube = {{#isyoutube}}true{{/isyoutube}}{{^isyoutube}}false{{/isyoutube}};
    if (!isYouTube) {
        var video = document.getElementById('videotrack-player');
        if (video) {
            video.addEventListener('play', function() {
                $('#vt-resume-overlay').fadeOut();
            });
            video.addEventListener('loadedmetadata', syncParentIframeHeight);
            video.addEventListener('loadeddata', syncParentIframeHeight);
        }
    }
});
