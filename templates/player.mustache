{{!
    @template mod_videotrack/player

    VideoTrack player template.

    Context variables required for this template:
    * isyoutube - Whether the video is from YouTube.
    * ytid - The YouTube video ID.
    * videourl - The URL of the video file (if not YouTube).
    * progresstitle - The title for the progress section.
    * currentpercent - The current progress percentage.
    * progresshint - A hint text about the required progress.
    * iscompleted - Whether the user has reached the required percentage.
    * successmsg - The success message to show upon completion.

    Example context (json):
    {
        "isyoutube": false,
        "ytid": "",
        "videourl": "https://example.com/video.mp4",
        "progresstitle": "Progress",
        "currentpercent": 50,
        "progresshint": "Watch 80% to complete",
        "iscompleted": false,
        "successmsg": "Congratulations!"
    }
}}
<div class="videotrack-container p-3 mb-4 bg-white rounded border shadow-sm">
    <!-- Main Video Wrapper -->
    <div class="vt-player-wrapper" style="position: relative; border-radius: 8px; overflow: hidden; background: #000;">
        
        {{^isgdrive}}
        {{#showresumebutton}}
            <!-- Resume Overlay -->
            <div id="vt-resume-overlay" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10;">
                <button id="vt-resume-btn" onclick="if(window.videotrackResume) window.videotrackResume(); return false;">
                    <i class="fa fa-play"></i> {{ resumebtntext }}
                </button>
            </div>
        {{/showresumebutton}}
        {{/isgdrive}}

        {{#isyoutube}}
            <!-- YouTube API Player Container -->
            <div class="vt-video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; border-radius: var(--vt-rad, 8px);">
                <div id="youtube-player" data-videoid="{{ytid}}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></div>
            </div>
        {{/isyoutube}}
        
        {{^isyoutube}}
            {{#isgdrive}}
                <!-- Google Drive Iframe (No Tracking) -->
                <div class="vt-video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; border-radius: var(--vt-rad, 8px);">
                    <iframe src="{{videourl}}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" allowfullscreen="true" webkitallowfullscreen="true" mozallowfullscreen="true"></iframe>
                </div>
            {{/isgdrive}}
            {{^isgdrive}}
                <!-- Native HTML5 Player (Local files / Direct MP4) -->
                <div class="vt-video-container vt-html5-container" style="border-radius: var(--vt-rad, 8px); overflow: hidden; background: #000; display: flex; align-items: center; justify-content: center; width: 100%; height: var(--vt-h5-h, auto);">
                    <video id="videotrack-player" preload="metadata" playsinline style="width: 100%; max-height: var(--vt-h5-maxh, 650px); object-fit: contain;">
                        <source src="{{videourl}}" type="video/mp4">
                        Tu navegador no soporta video HTML5.
                    </video>
                </div>
            {{/isgdrive}}
        {{/isyoutube}}
        
        <!-- Floating Reactions Container -->
        <div id="vt-floating-reactions" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 15; overflow: hidden;"></div>
        
        {{^isgdrive}}
        <!-- Custom Controls (HeyGen Style) -->
        <div class="vt-custom-controls" id="vt-custom-controls">
            <!-- Progress Bar Row -->
            <div class="vt-progress-container">
                <input type="range" id="vt-seek-slider" class="vt-seek-slider" min="0" max="100" value="0" step="0.1">
                <!-- Reaction Markers Container (Overlayed perfectly on slider) -->
                <div id="vt-reaction-markers" style="position: absolute; bottom: 12px; left: 0; width: 100%; pointer-events: none; z-index: 20;"></div>
            </div>
            
            <!-- Buttons Row -->
            <div class="vt-controls-row">
                <div class="vt-controls-left">
                    <button class="vt-ctrl-btn vt-play-pause-btn" id="vt-play-pause-btn" title="Play/Pause">
                        <i class="fa fa-play"></i>
                    </button>
                    <button class="vt-ctrl-btn vt-mute-btn" id="vt-mute-btn" title="Mute/Unmute">
                        <i class="fa fa-volume-up"></i>
                    </button>
                </div>
                
                <div class="vt-controls-center">
                    <div class="vt-time-display" id="vt-time-display">0:00 / 0:00</div>
                </div>
                
                <div class="vt-controls-right">
                    <button class="vt-ctrl-btn vt-fullscreen-btn" id="vt-fullscreen-btn" title="Fullscreen">
                        <i class="fa fa-expand"></i>
                    </button>
                </div>
            </div>
        </div>
        {{/isgdrive}}
    </div> <!-- Close .vt-player-wrapper -->

    {{^isgdrive}}
    <!-- Reaction Bar (Individual Circles Style) -->
    <div style="display: flex; justify-content: center; flex-wrap: wrap; margin-top: 15px; position: relative; z-index: 50; gap: 15px;">
        <button class="vt-react-btn" data-reaction="heart" onclick="if(window.videotrackReact) window.videotrackReact('heart'); return false;">❤️</button>
        <button class="vt-react-btn" data-reaction="laugh" onclick="if(window.videotrackReact) window.videotrackReact('laugh'); return false;">😂</button>
        <button class="vt-react-btn" data-reaction="like" onclick="if(window.videotrackReact) window.videotrackReact('like'); return false;">👍</button>
        <button class="vt-react-btn" data-reaction="wow" onclick="if(window.videotrackReact) window.videotrackReact('wow'); return false;">😲</button>
        <button class="vt-react-btn" data-reaction="clap" onclick="if(window.videotrackReact) window.videotrackReact('clap'); return false;">👏🏼</button>
        <button class="vt-react-btn" data-reaction="ok" onclick="if(window.videotrackReact) window.videotrackReact('ok'); return false;">👌🏼</button>
        <button class="vt-react-btn" data-reaction="raisedhands" onclick="if(window.videotrackReact) window.videotrackReact('raisedhands'); return false;">🙌🏼</button>
        <button class="vt-react-btn" data-reaction="thinking" onclick="if(window.videotrackReact) window.videotrackReact('thinking'); return false;">🤔</button>
        <button class="vt-react-btn" data-reaction="rocket" onclick="if(window.videotrackReact) window.videotrackReact('rocket'); return false;">🚀</button>
    </div>
    {{/isgdrive}}

    <!-- Progress Interface -->
    <div class="mt-4 px-2">

        {{#isgdrive}}
            <div class="text-muted small mt-2" style="display: flex; align-items: center; justify-content: center; gap: 8px; background-color: #f8fafc; padding: 14px 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
                <i class="fa fa-info-circle" style="color: #64748b; font-size: 1.2em;"></i> 
                <span style="color: #475569; font-weight: 500;">{{{ gdrivenotrack }}}</span>
            </div>
        {{/isgdrive}}
        {{^isgdrive}}
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <div style="display: flex; flex-direction: column; gap: 4px;">
                <h4 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #0f172a; letter-spacing: -0.01em;">{{ progresstitle }}</h4>
                <p style="margin: 0; font-size: 0.875rem; color: #64748b; line-height: 1.4;">{{{ progresshint }}}</p>
            </div>
            <div style="background: #f8fafc; padding: 6px 14px; border-radius: 24px; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; justify-content: center; min-width: 65px;">
                <span id="vt-progress-text" style="font-size: 1rem; font-weight: 700; color: #0ea5e9; line-height: 1;">{{currentpercent}}%</span>
            </div>
        </div>

        <div style="height: 12px; border-radius: 100px; background-color: #f1f5f9; overflow: hidden; position: relative; box-shadow: inset 0 1px 2px rgba(0,0,0,0.04);">
            <div id="vt-progress-bar" role="progressbar" style="height: 100%; width: {{currentpercent}}%; border-radius: 100px; background: linear-gradient(90deg, #0ea5e9 0%, #3b82f6 100%); transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: inset 0 -1px 2px rgba(0,0,0,0.1), 0 2px 4px rgba(59, 130, 246, 0.3);" aria-valuenow="{{currentpercent}}" aria-valuemin="0" aria-valuemax="100">
            </div>
        </div>
        
        <!-- Success message -->
        <div id="vt-success-msg" class="mt-4 {{^iscompleted}}d-none{{/iscompleted}}" style="display: flex; align-items: center; gap: 14px; background: #f0fdf4; padding: 16px 20px; border-radius: 12px; border: 1px solid #bbf7d0; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.08); transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);">
            <div style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.4);">
                <i class="fa fa-check" style="font-size: 15px;"></i>
            </div>
            <div>
                <span style="font-weight: 600; font-size: 0.95rem; color: #065f46; letter-spacing: -0.01em;">{{ successmsg }}</span>
            </div>
        </div>
        {{/isgdrive}}
    </div>
</div>

{{#js}}
require(['jquery'], function($) {
    window.videotrackResume = function() {
        var targetPercent = Number("{{currentpercent}}") || 0;
        var isYouTube = {{#isyoutube}}true{{/isyoutube}}{{^isyoutube}}false{{/isyoutube}};

        if (!isYouTube) {
            var video = document.getElementById('videotrack-player');
            if (!video) {
                return;
            }

            var doResume = function() {
                var targetTime = (targetPercent / 100) * video.duration;
                video.currentTime = targetTime;
                video.play();
                $('#vt-resume-overlay').fadeOut();
            };

            if (video.readyState >= 1) {
                doResume();
            } else {
                video.addEventListener('loadedmetadata', doResume, {once: true});
                video.load();
            }
        } else {
            if (window.ytPlayer && window.ytPlayer.playVideo) {
                window.ytPlayer.playVideo();
                var checkInterval = setInterval(function() {
                    var dur = window.ytPlayer.getDuration();
                    if (dur && dur > 0) {
                        clearInterval(checkInterval);
                        window.ytPlayer.seekTo((targetPercent / 100) * dur, true);
                        $('#vt-resume-overlay').fadeOut();
                    }
                }, 200);
            }
        }
    };

    $('#vt-resume-btn').on('click', function(e) {
        e.preventDefault();
        window.videotrackResume();
    });

    // Hide button if the video is played manually
    var isYouTube = {{#isyoutube}}true{{/isyoutube}}{{^isyoutube}}false{{/isyoutube}};
    if (!isYouTube) {
        var video = document.getElementById('videotrack-player');
        if (video) {
            video.addEventListener('play', function() {
                $('#vt-resume-overlay').fadeOut();
            });
        }
    }
});

{{^isgdrive}}
require(['mod_videotrack/reactions', 'mod_videotrack/controls'], function(reactions, controls) {
    var isYouTube = {{#isyoutube}}true{{/isyoutube}}{{^isyoutube}}false{{/isyoutube}};
    var cmid = "{{cmid}}";
    var ytid = "{{ytid}}";

    // Initialize custom controls
    controls.init(isYouTube, ytid);

    // Initialize reactions
    reactions.init(cmid, isYouTube, ytid);
});
{{/isgdrive}}
{{/js}}
