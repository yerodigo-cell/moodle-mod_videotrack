    <!-- Main Video Wrapper (Edge-to-Edge inside card) -->
    <div class="vt-player-wrapper">
        {{^isgdrive}}
        {{#showresumebutton}}
            <!-- Resume Overlay -->
            <div id="vt-resume-overlay" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 10;">
                <button id="vt-resume-btn" onclick="if(window.videotrackResume) window.videotrackResume(); return false;">
                    <i class="fa fa-play"></i> {{ resumebtntext }}
                </button>
            </div>
        {{/showresumebutton}}
        {{/isgdrive}}

        {{#isyoutube}}
            <!-- YouTube API Player Container -->
            <div class="vt-video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; border-radius: 0;">
                <div id="youtube-player" data-videoid="{{ytid}}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></div>
            </div>
        {{/isyoutube}}

        {{^isyoutube}}
            {{#isgdrive}}
                {{#showresumebutton}}
                <!-- Manual Resume Hint -->
                <div id="vt-resume-hint-alert" style="display: flex; align-items: center; justify-content: space-between; background-color: #f8fafc; padding: 12px 16px; border-bottom: 1px solid #e2e8f0; color: #475569; font-size: 0.9rem;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="background: #e2e8f0; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <i class="fa fa-history" style="color: #475569; font-size: 1rem;"></i>
                        </div>
                        <span>{{{ manualresumehint }}}</span>
                    </div>
                    <button type="button" onclick="document.getElementById('vt-resume-hint-alert').style.display='none';" style="background: transparent; border: none; color: #94a3b8; cursor: pointer; padding: 8px; border-radius: 4px; transition: color 0.2s;" onmouseover="this.style.color='#334155'" onmouseout="this.style.color='#94a3b8'" title="Cerrar">
                        <i class="fa fa-times" style="font-size: 1.1rem;"></i>
                    </button>
                </div>
                {{/showresumebutton}}
                <!-- Google Drive Iframe (No Tracking) -->
                <div class="vt-video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; border-radius: 0;">
                    <iframe src="{{videourl}}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" allowfullscreen="true" webkitallowfullscreen="true" mozallowfullscreen="true"></iframe>
                </div>
            {{/isgdrive}}

            {{^isgdrive}}
                <!-- Native HTML5 Player (Local files / Direct MP4) -->
                <div class="vt-video-container vt-html5-container" style="border-radius: 0; overflow: hidden; background: #000; display: flex; align-items: center; justify-content: center; width: 100%; height: var(--vt-h5-h, auto);">
                    <video id="videotrack-player" preload="metadata" playsinline crossorigin="anonymous" style="width: 100%; max-height: var(--vt-h5-maxh, 650px); object-fit: contain; display: block;">
                        {{#videourl}}<source src="{{videourl}}" type="video/mp4">{{/videourl}}
                        {{#hascaptions}}
                        <track id="vt-captions-track" kind="captions" src="{{captionsurl}}" srclang="en" label="Subtitles" default>
                        {{/hascaptions}}
                        Tu navegador no soporta video HTML5.
                    </video>
                </div>
            {{/isgdrive}}
        {{/isyoutube}}

        <!-- Floating Reactions Container -->
        <div id="vt-floating-reactions" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 15; overflow: hidden;"></div>

        <!-- Custom Unified Captions Container -->
        <div id="vt-custom-captions" class="vt-custom-captions"></div>

        {{^isgdrive}}
