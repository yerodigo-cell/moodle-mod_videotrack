{{!
    @template mod_videotrack/player

    VideoTrack player template.

    Example context (json):
    {
        "cmid": 42,
        "activityname": "Introduction Video",
        "videourl": "https://example.com/video.mp4",
        "isyoutube": false,
        "ytid": "",
        "isgdrive": false,
        "hascaptions": false,
        "captionsurl": "",
        "accentcolor": "#0ea5e9",
        "hascustomaccent": false,
        "isembed": false,
        "inpopup": false,
        "courseurl": "https://example.com/course/view.php?id=2",
        "backtocoursetext": "Back to course",
        "canmanage": false,
        "settingsurl": "https://example.com/course/modedit.php?update=42",
        "settingslabel": "Settings",
        "reporturl": "https://example.com/mod/videotrack/report.php?id=42",
        "reportlabel": "Report",
        "focusmode": true,
        "focusmodebadge": "Focus Mode",
        "focusmodepaused": "Paused - Focus Mode",
        "showresumebutton": false,
        "resumebtntext": "Resume",
        "manualresumehint": "",
        "showprogressbar": true,
        "gdrivenotrack": "",
        "progresstitle": "Viewing progress",
        "progresshint": "Watch at least 80% to complete.",
        "currentpercent": 50,
        "highesttime": 30,
        "iscompleted": false,
        "successmsg": "Activity completed!"
    }
}}

<div class="videotrack-container videotrack-card {{#hascustomaccent}}vt-has-custom-accent{{/hascustomaccent}} {{#isembed}}vt-is-embed{{/isembed}} {{#inpopup}}vt-in-popup{{/inpopup}}" {{#accentcolor}}style="--vt-accent: {{accentcolor}};"{{/accentcolor}}>
